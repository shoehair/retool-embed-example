# Copy this file to .env and fill in the four INSERT_ values.

# The Retool instance you are embedding from, no trailing slash.
RETOOL_HOST=INSERT_RETOOL_HOST_HERE

# Access token with the apps:embed scope.
# Retool → Settings → API tokens (or Personal access tokens).
RETOOL_PAT=INSERT_PAT_HERE

# UUID of the app to embed — the id in the app's editor URL.
RETOOL_APP_UUID=INSERT_APP_UUID_HERE

# Comma-separated group ids the embedded user should belong to, e.g. 1234 or 1234,5678.
# The admin group is silently ignored here, so use a non-admin group.
RETOOL_GROUP_IDS=INSERT_GROUP_IDS_HERE

# The demo login for this example site. Any values you like.
AUTH_USERNAME=demo
AUTH_PASSWORD=demo
